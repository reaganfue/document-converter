"""
app.py — Flask 主程式

職責：
- 所有 REST API 路由
- Job 管理（in-memory，thread-safe）
- ThreadPoolExecutor 非同步轉換排程
- 臨時檔案管理（UUID 子目錄 + TTL 清理）
- COM 執行緒安全（CoInitialize / CoUninitialize）
"""

from __future__ import annotations

import io
import logging
import os
import shutil
import threading
import time
import uuid
import zipfile
from concurrent.futures import ThreadPoolExecutor, TimeoutError as FuturesTimeoutError
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Dict, List, Optional

from flask import Flask, jsonify, render_template, request, send_file
from werkzeug.utils import secure_filename

from config import (
    CLEANUP_AFTER_FAILURE_SEC,
    CLEANUP_AFTER_SUCCESS_SEC,
    CLEANUP_SCAN_INTERVAL_SEC,
    CLEANUP_STALE_AGE_SEC,
    CONVERSION_MATRIX,
    CONVERSION_TIMEOUT_SEC,
    ERROR_MESSAGES,
    EXT_TO_FORMAT,
    MAX_CONCURRENT_JOBS,
    MAX_FILE_SIZE,
    MAX_FILES_PER_JOB,
    MAX_TOTAL_SIZE,
    OUTPUT_DIR,
    SUPPORTED_FORMATS,
    UPLOAD_DIR,
    UPLOAD_EXTENSIONS,
)

# ---------- 日誌設定 ----------
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s — %(message)s",
    datefmt="%Y-%m-%dT%H:%M:%S",
)
logger = logging.getLogger(__name__)

# ---------- Flask App ----------
app = Flask(__name__)
app.config["MAX_CONTENT_LENGTH"] = MAX_TOTAL_SIZE
app.config["SECRET_KEY"] = os.environ.get("FLASK_SECRET_KEY", os.urandom(32))
app.config["JSON_AS_ASCII"] = False

# ---------- 轉換模組匯入（容錯） ----------
# 始終定義 convert_file 與 ConversionError，讓測試可以 mock app.convert_file。
# 若 converters/ 就緒，真實實作會覆蓋佔位定義。

class ConversionError(Exception):
    """轉換錯誤基類（佔位）。當 converters/ 就緒後由真實模組的同名例外替換。"""


def convert_file(
    input_path: str,
    output_path: str,
    source_format: str,
    target_format: str,
) -> None:
    """轉換入口佔位函式。當 converters/ 就緒後由真實實作替換。

    參數名稱與 converters/dispatcher.py 的真實簽名一致，
    避免 kwarg 不匹配導致 TypeError。
    """
    raise ConversionError("converters/ 模組尚未就緒，請確認 P2B 已部署完成。")


def get_supported_matrix():
    """回傳支援矩陣佔位函式。"""
    return {}


try:
    from converters.dispatcher import (  # type: ignore[assignment]
        convert_file,
        get_supported_matrix,
    )
    from converters.exceptions import (  # type: ignore[assignment]
        ConversionError,
        UnsupportedFormatError,
    )
    from converters.pdf_renderer import diagnose_pdf_backends
    _converters_available = True
except ImportError:
    logger.warning(
        "converters/ 模組尚未就緒，轉換功能暫時不可用。"
        "請確認 P2B 已部署完成。"
    )
    _converters_available = False

    def diagnose_pdf_backends() -> dict:  # type: ignore[misc]
        """converters/ 未就緒時的佔位實作，回傳空字典。"""
        return {}


# ---------- 資料模型 ----------


@dataclass
class FileTask:
    """單一檔案的轉換任務記錄。"""

    index: int
    original_name: str
    size: int
    upload_path: str
    output_path: Optional[str] = None
    status: str = "pending"  # pending | processing | completed | failed
    error: Optional[str] = None


@dataclass
class Job:
    """一個轉換 Job（可包含多個檔案）。"""

    job_id: str
    status: str  # queued | processing | completed | partial | failed | delivered
    files: List[FileTask]
    created_at: datetime
    updated_at: datetime
    target_format: str
    progress: float = 0.0          # 0.0 ~ 1.0
    error: Optional[str] = None
    download_url: Optional[str] = None


# ---------- 全域狀態 ----------
JOBS: Dict[str, Job] = {}
JOBS_LOCK = threading.Lock()
EXECUTOR = ThreadPoolExecutor(max_workers=4)


# ---------- 輔助函式 ----------


def _now() -> datetime:
    """回傳 UTC 當前時間（帶時區）。"""
    return datetime.now(timezone.utc)


def _iso(dt: datetime) -> str:
    """datetime → ISO-8601 字串（UTC）。"""
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def _get_extension(filename: str) -> str:
    """取得小寫副檔名（不含點）。"""
    return Path(filename).suffix.lstrip(".").lower()


def _detect_source_format(filename: str) -> Optional[str]:
    """從副檔名推導 source format key。"""
    ext = _get_extension(filename)
    return EXT_TO_FORMAT.get(ext)


def _is_conversion_supported(source_fmt: str, target_fmt: str) -> bool:
    """檢查轉換對是否在支援矩陣內。"""
    return target_fmt in CONVERSION_MATRIX.get(source_fmt, {})


def _safe_filename(original: str, index: int) -> str:
    """
    清理檔名並加索引前綴，防止路徑穿越與重名。

    Steps:
    1. secure_filename() 清除危險字元
    2. 加 index 前綴（0_, 1_, 2_, ...）
    """
    cleaned = secure_filename(original)
    if not cleaned:
        cleaned = "file"
    return f"{index}_{cleaned}"


def _build_output_filename(upload_name: str, target_ext: str) -> str:
    """
    由上傳檔名推導輸出檔名，替換副檔名。
    例：0_report.pdf + docx → 0_report.docx
    """
    stem = Path(upload_name).stem
    return f"{stem}.{target_ext}"


def _count_active_jobs() -> int:
    """計算 queued 或 processing 狀態的 Job 數量（需在 JOBS_LOCK 內呼叫）。"""
    return sum(
        1 for job in JOBS.values()
        if job.status in ("queued", "processing")
    )


def _update_job_progress(job: Job) -> None:
    """根據 files 的狀態重算 job.progress 並決定整體 status。"""
    total = len(job.files)
    if total == 0:
        job.progress = 1.0
        job.status = "completed"
        return

    done = sum(1 for f in job.files if f.status in ("completed", "failed"))
    succeeded = sum(1 for f in job.files if f.status == "completed")
    job.progress = done / total

    if done == total:
        if succeeded == total:
            job.status = "completed"
        elif succeeded > 0:
            job.status = "partial"
        else:
            job.status = "failed"
        job.download_url = f"/api/download/{job.job_id}"
    elif any(f.status == "processing" for f in job.files):
        job.status = "processing"

    job.updated_at = _now()


# ---------- 清理相關 ----------


def _remove_job_dirs(job_id: str, delay_sec: float = 0.0) -> None:
    """
    背景執行緒：延遲後刪除 uploads/<job_id>/ 和 outputs/<job_id>/。
    delay_sec: 刪除前等待秒數。
    """
    def _do_remove() -> None:
        if delay_sec > 0:
            time.sleep(delay_sec)
        for base_dir in (UPLOAD_DIR, OUTPUT_DIR):
            target = base_dir / job_id
            if target.exists():
                try:
                    shutil.rmtree(target)
                    logger.info("已清理目錄 %s", target)
                except OSError as exc:
                    logger.warning("清理目錄 %s 失敗：%s", target, exc)

    thread = threading.Thread(target=_do_remove, daemon=True)
    thread.start()


def cleanup_stale_dirs() -> None:
    """
    掃描 uploads/ 和 outputs/，刪除超過 CLEANUP_STALE_AGE_SEC 的子目錄。
    在程式啟動時及 TTL worker 中呼叫。

    跳過仍處於 queued 或 processing 狀態的 job 目錄，
    防止系統時鐘漂移或設定過短時刪除進行中的任務。
    """
    cutoff = time.time() - CLEANUP_STALE_AGE_SEC

    # 取得活躍 job_id 集合（避免 JOBS_LOCK 持有太久）
    with JOBS_LOCK:
        active_ids = {
            job_id
            for job_id, job in JOBS.items()
            if job.status in ("queued", "processing")
        }

    for base_dir in (UPLOAD_DIR, OUTPUT_DIR):
        if not base_dir.exists():
            continue
        for sub in base_dir.iterdir():
            if not sub.is_dir():
                continue
            # 跳過活躍中的 job 目錄
            if sub.name in active_ids:
                continue
            if sub.stat().st_mtime < cutoff:
                try:
                    shutil.rmtree(sub)
                    logger.info("啟動清理：已刪除過期目錄 %s", sub)
                except OSError as exc:
                    logger.warning("啟動清理：刪除 %s 失敗：%s", sub, exc)


def _cleanup_worker_loop() -> None:
    """背景 TTL worker：每 CLEANUP_SCAN_INTERVAL_SEC 執行一次 cleanup_stale_dirs。"""
    while True:
        time.sleep(CLEANUP_SCAN_INTERVAL_SEC)
        try:
            cleanup_stale_dirs()
        except Exception as exc:
            logger.error("TTL 清理 worker 發生錯誤：%s", exc, exc_info=True)


def start_cleanup_worker() -> None:
    """啟動 daemon 背景清理執行緒。"""
    thread = threading.Thread(target=_cleanup_worker_loop, daemon=True, name="ttl-cleanup")
    thread.start()
    logger.info("TTL 清理 worker 已啟動，掃描間隔 %ds", CLEANUP_SCAN_INTERVAL_SEC)


# ---------- 轉換 Worker ----------


def _convert_single_file(
    job_id: str,
    file_task: FileTask,
    target_format: str,
) -> None:
    """
    在 ThreadPool worker 執行緒中轉換單一檔案。

    COM 安全：若可用，在 worker 執行緒內呼叫 CoInitialize / CoUninitialize。
    轉換逾時：透過 concurrent.futures 的 timeout 機制處理。
    """
    # COM 初始化（僅 Windows，且 pywin32 可用時）
    _com_initialized = False
    try:
        import pythoncom
        pythoncom.CoInitialize()
        _com_initialized = True
    except ImportError:
        pass  # 非 Windows 或 pywin32 未安裝，略過

    try:
        with JOBS_LOCK:
            file_task.status = "processing"
            job = JOBS.get(job_id)
            if job:
                _update_job_progress(job)
                if job.status == "queued":
                    job.status = "processing"

        source_fmt = _detect_source_format(file_task.original_name)
        if not source_fmt:
            raise ConversionError(
                ERROR_MESSAGES["invalid_file"].format(name=file_task.original_name)
            )

        target_ext = SUPPORTED_FORMATS[target_format]["ext"]
        upload_path = Path(file_task.upload_path)
        output_filename = _build_output_filename(upload_path.name, target_ext)
        output_path = OUTPUT_DIR / job_id / output_filename
        output_path.parent.mkdir(parents=True, exist_ok=True)

        if not _converters_available:
            raise ConversionError("converters/ 模組尚未就緒")

        convert_file(
            input_path=str(upload_path),
            output_path=str(output_path),
            source_format=source_fmt,
            target_format=target_format,
        )

        with JOBS_LOCK:
            file_task.output_path = str(output_path)
            file_task.status = "completed"
            job = JOBS.get(job_id)
            if job:
                _update_job_progress(job)

        logger.info(
            "job=%s 檔案 %s 轉換完成 → %s",
            job_id, file_task.original_name, output_path.name,
        )

    except ConversionError as exc:
        error_msg = str(exc)
        with JOBS_LOCK:
            file_task.status = "failed"
            file_task.error = error_msg
            job = JOBS.get(job_id)
            if job:
                _update_job_progress(job)
        logger.error("job=%s 檔案 %s 轉換失敗：%s", job_id, file_task.original_name, error_msg)

    except Exception as exc:
        error_msg = ERROR_MESSAGES["conversion_failed"].format(
            name=file_task.original_name, reason=str(exc)
        )
        with JOBS_LOCK:
            file_task.status = "failed"
            file_task.error = error_msg
            job = JOBS.get(job_id)
            if job:
                _update_job_progress(job)
        logger.exception(
            "job=%s 檔案 %s 發生未預期錯誤", job_id, file_task.original_name
        )

    finally:
        # COM 清理
        if _com_initialized:
            try:
                import pythoncom
                pythoncom.CoUninitialize()
            except Exception:
                pass

        # Job 完成後觸發清理排程
        with JOBS_LOCK:
            job = JOBS.get(job_id)
            if job and job.status in ("completed", "partial", "failed"):
                all_done = all(
                    f.status in ("completed", "failed") for f in job.files
                )
                if all_done:
                    delay = (
                        CLEANUP_AFTER_SUCCESS_SEC
                        if job.status in ("completed", "partial")
                        else CLEANUP_AFTER_FAILURE_SEC
                    )
                    _remove_job_dirs(job_id, delay_sec=delay)


def _submit_job(job: Job) -> None:
    """將 Job 的所有檔案任務提交到 ThreadPoolExecutor。"""
    for file_task in job.files:
        EXECUTOR.submit(_convert_single_file, job.job_id, file_task, job.target_format)


# ---------- 路由 ----------


@app.route("/")
def index() -> str:
    """渲染首頁。"""
    return render_template("index.html")


@app.route("/api/health")
def api_health():
    """健康檢查端點。

    回傳系統整體狀態與各 PDF 渲染引擎的可用性診斷，
    讓前端或運維工具能快速識別 PDF 後端問題。
    """
    return jsonify({
        "status": "ok",
        "converters_ready": _converters_available,
        "pdf_backends": diagnose_pdf_backends(),
    })


@app.route("/api/formats")
def api_formats():
    """回傳支援格式與轉換矩陣（前端用來動態建構 UI）。"""
    return jsonify({
        "formats": SUPPORTED_FORMATS,
        "matrix": CONVERSION_MATRIX,
    })


@app.route("/api/convert", methods=["POST"])
def api_convert():
    """
    接收多檔上傳並建立轉換 Job。

    Request: multipart/form-data
        files:         File[]
        target_format: str

    Response 202:
        { job_id, file_count, queued_at, estimated_duration_sec }
    """
    # --- 驗證必填欄位 ---
    if "files" not in request.files:
        return jsonify({"error": ERROR_MESSAGES["no_files"]}), 400

    target_format = request.form.get("target_format", "").strip().lower()
    if not target_format:
        return jsonify({"error": ERROR_MESSAGES["missing_target_format"]}), 400

    if target_format not in SUPPORTED_FORMATS:
        return jsonify({
            "error": ERROR_MESSAGES["unsupported_format"].format(
                src="(unknown)", tgt=target_format
            )
        }), 415

    uploaded_files = request.files.getlist("files")

    # --- 驗證檔案清單 ---
    if not uploaded_files or all(f.filename == "" for f in uploaded_files):
        return jsonify({"error": ERROR_MESSAGES["no_files"]}), 400

    if len(uploaded_files) > MAX_FILES_PER_JOB:
        return jsonify({
            "error": ERROR_MESSAGES["too_many_files"].format(max=MAX_FILES_PER_JOB)
        }), 400

    # --- 檢查同時 Job 數上限 ---
    with JOBS_LOCK:
        if _count_active_jobs() >= MAX_CONCURRENT_JOBS:
            return jsonify({"error": ERROR_MESSAGES["too_many_jobs"]}), 503

    # --- 建立 Job 目錄 ---
    job_id = str(uuid.uuid4())
    upload_subdir = UPLOAD_DIR / job_id
    output_subdir = OUTPUT_DIR / job_id
    upload_subdir.mkdir(parents=True, exist_ok=True)
    output_subdir.mkdir(parents=True, exist_ok=True)

    file_tasks: List[FileTask] = []
    total_size = 0

    for idx, file_obj in enumerate(uploaded_files):
        if not file_obj.filename:
            continue

        original_name = file_obj.filename
        ext = _get_extension(original_name)

        # --- 副檔名白名單 ---
        if ext not in UPLOAD_EXTENSIONS:
            shutil.rmtree(upload_subdir, ignore_errors=True)
            shutil.rmtree(output_subdir, ignore_errors=True)
            return jsonify({
                "error": ERROR_MESSAGES["unsupported_format"].format(
                    src=ext.upper(), tgt=target_format.upper()
                )
            }), 415

        # --- 格式支援矩陣 ---
        source_fmt = _detect_source_format(original_name)
        if source_fmt and not _is_conversion_supported(source_fmt, target_format):
            shutil.rmtree(upload_subdir, ignore_errors=True)
            shutil.rmtree(output_subdir, ignore_errors=True)
            return jsonify({
                "error": ERROR_MESSAGES["unsupported_format"].format(
                    src=source_fmt.upper(), tgt=target_format.upper()
                )
            }), 415

        # --- 儲存上傳檔案 ---
        safe_name = _safe_filename(original_name, idx)
        save_path = upload_subdir / safe_name

        # 讀取並檢查大小（避免先全部存到磁碟再報錯）
        content = file_obj.read()
        file_size = len(content)
        total_size += file_size

        if file_size > MAX_FILE_SIZE:
            shutil.rmtree(upload_subdir, ignore_errors=True)
            shutil.rmtree(output_subdir, ignore_errors=True)
            return jsonify({
                "error": ERROR_MESSAGES["file_too_large"].format(name=original_name)
            }), 413

        if total_size > MAX_TOTAL_SIZE:
            shutil.rmtree(upload_subdir, ignore_errors=True)
            shutil.rmtree(output_subdir, ignore_errors=True)
            return jsonify({"error": ERROR_MESSAGES["total_too_large"]}), 413

        # 拒絕 symlink（安全防護）
        # 先檢查父目錄與目標路徑是否為 symlink，再寫入（防止 TOCTOU 競態）。
        # 用 'xb' 模式（exclusive create binary）確保原子性建立，
        # 若檔案已存在則拋 FileExistsError（可能是 symlink 攻擊）。
        if upload_subdir.is_symlink():
            shutil.rmtree(upload_subdir, ignore_errors=True)
            shutil.rmtree(output_subdir, ignore_errors=True)
            return jsonify({
                "error": ERROR_MESSAGES["symlink_rejected"].format(name=original_name)
            }), 400
        try:
            with open(save_path, 'xb') as fd:
                fd.write(content)
        except FileExistsError:
            shutil.rmtree(upload_subdir, ignore_errors=True)
            shutil.rmtree(output_subdir, ignore_errors=True)
            return jsonify({
                "error": ERROR_MESSAGES["symlink_rejected"].format(name=original_name)
            }), 400

        file_tasks.append(FileTask(
            index=idx,
            original_name=original_name,
            size=file_size,
            upload_path=str(save_path),
        ))

    if not file_tasks:
        shutil.rmtree(upload_subdir, ignore_errors=True)
        shutil.rmtree(output_subdir, ignore_errors=True)
        return jsonify({"error": ERROR_MESSAGES["no_files"]}), 400

    # --- 建立 Job 並提交執行 ---
    now = _now()
    job = Job(
        job_id=job_id,
        status="queued",
        files=file_tasks,
        created_at=now,
        updated_at=now,
        target_format=target_format,
    )

    with JOBS_LOCK:
        JOBS[job_id] = job

    _submit_job(job)

    estimated = len(file_tasks) * 5  # 粗估：每檔 5 秒
    logger.info(
        "job=%s 已建立，%d 個檔案，目標格式=%s",
        job_id, len(file_tasks), target_format,
    )

    return jsonify({
        "job_id": job_id,
        "file_count": len(file_tasks),
        "queued_at": _iso(now),
        "estimated_duration_sec": estimated,
    }), 202


@app.route("/api/status/<job_id>")
def api_status(job_id: str):
    """
    回傳 Job 當前狀態。

    Response 200:
        { job_id, status, progress, files: [...], download_url }
    """
    with JOBS_LOCK:
        job = JOBS.get(job_id)
        if not job:
            return jsonify({
                "error": ERROR_MESSAGES["unknown_job"].format(job_id=job_id)
            }), 404

        file_list = []
        for ft in job.files:
            output_name = None
            if ft.output_path:
                output_name = Path(ft.output_path).name
            file_list.append({
                "name": ft.original_name,
                "status": ft.status,
                "output": output_name,
                "error": ft.error,
            })

        return jsonify({
            "job_id": job.job_id,
            "status": job.status,
            "progress": round(job.progress, 4),
            "files": file_list,
            "download_url": job.download_url,
            "created_at": _iso(job.created_at),
            "updated_at": _iso(job.updated_at),
        })


@app.route("/api/download/<job_id>")
def api_download(job_id: str):
    """
    下載轉換結果。
    - 單檔：直接回傳檔案串流
    - 多檔：打包為 ZIP 回傳
    下載後 Job 標記為 delivered，延遲 60 秒清理。
    """
    with JOBS_LOCK:
        job = JOBS.get(job_id)
        if not job:
            return jsonify({
                "error": ERROR_MESSAGES["unknown_job"].format(job_id=job_id)
            }), 404

        if job.status not in ("completed", "partial", "delivered"):
            return jsonify({
                "error": f"任務狀態為 {job.status}，無法下載"
            }), 400

        completed_files = [
            ft for ft in job.files if ft.status == "completed" and ft.output_path
        ]

    if not completed_files:
        return jsonify({"error": "沒有可下載的轉換結果"}), 404

    if len(completed_files) == 1:
        output_path = Path(completed_files[0].output_path)
        if not output_path.exists():
            return jsonify({"error": "輸出檔案不存在或已被清理"}), 404

        _mark_delivered_and_schedule_cleanup(job_id)

        return send_file(
            output_path,
            as_attachment=True,
            download_name=output_path.name,
            mimetype="application/octet-stream",
        )

    # 多檔 → ZIP
    zip_buffer = io.BytesIO()
    with zipfile.ZipFile(zip_buffer, "w", zipfile.ZIP_DEFLATED) as zf:
        for ft in completed_files:
            path = Path(ft.output_path)
            if path.exists():
                zf.write(path, arcname=path.name)

    zip_buffer.seek(0)
    _mark_delivered_and_schedule_cleanup(job_id)

    return send_file(
        zip_buffer,
        as_attachment=True,
        download_name=f"converted_{job_id[:8]}.zip",
        mimetype="application/zip",
    )


def _mark_delivered_and_schedule_cleanup(job_id: str) -> None:
    """
    將 Job 狀態標記為 delivered 並排程延遲後清理目錄與記憶體 entry。
    應在 JOBS_LOCK 之外呼叫（內部會短暫加鎖）。
    """
    with JOBS_LOCK:
        job = JOBS.get(job_id)
        if job:
            job.status = "delivered"
            job.updated_at = _now()
    _remove_job_dirs(job_id, delay_sec=CLEANUP_AFTER_SUCCESS_SEC)
    # 磁碟清理完成後同步移除 JOBS entry，防止 in-memory 無界增長（W-PERF-001）
    _schedule_jobs_eviction(job_id, delay_sec=CLEANUP_AFTER_SUCCESS_SEC)


def _schedule_jobs_eviction(job_id: str, delay_sec: float) -> None:
    """在磁碟清理延遲後，從 JOBS dict 移除對應 entry。"""
    def _evict() -> None:
        if delay_sec > 0:
            time.sleep(delay_sec)
        with JOBS_LOCK:
            JOBS.pop(job_id, None)
        logger.debug("已從 JOBS dict 移除 job_id=%s", job_id)

    thread = threading.Thread(target=_evict, daemon=True)
    thread.start()


# ---------- 全局錯誤處理 ----------


@app.errorhandler(400)
def handle_bad_request(exc):
    """400 Bad Request"""
    return jsonify({"error": "請求格式錯誤", "detail": str(exc)}), 400


@app.errorhandler(413)
def handle_too_large(exc):
    """413 Payload Too Large"""
    return jsonify({
        "error": ERROR_MESSAGES["file_too_large"].format(name="上傳檔案"),
    }), 413


@app.errorhandler(404)
def handle_not_found(exc):
    """404 Not Found"""
    return jsonify({"error": "資源不存在"}), 404


@app.errorhandler(500)
def handle_server_error(exc):
    """500 Internal Server Error"""
    logger.exception("未預期的伺服器錯誤")
    return jsonify({"error": "伺服器發生內部錯誤，請稍後再試"}), 500


# ---------- 啟動入口 ----------


def _ensure_dirs() -> None:
    """確保 uploads/ 和 outputs/ 目錄存在。"""
    UPLOAD_DIR.mkdir(parents=True, exist_ok=True)
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    logger.info("上傳目錄：%s", UPLOAD_DIR)
    logger.info("輸出目錄：%s", OUTPUT_DIR)


if __name__ == "__main__":
    _ensure_dirs()
    cleanup_stale_dirs()
    start_cleanup_worker()
    logger.info("文件轉檔工具啟動中，監聽 http://127.0.0.1:5000")
    app.run(host="127.0.0.1", port=5000, debug=False)
