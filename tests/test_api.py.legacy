"""
test_api.py — Flask API 端點測試

涵蓋：
1.  test_health                        — GET /api/health 回 200 + {"status": "ok"}
2.  test_formats                       — GET /api/formats 回正確結構
3.  test_convert_missing_file          — POST /api/convert 無檔案回 400
4.  test_convert_missing_target_format — 無 target_format 回 400
5.  test_convert_oversized_single_file — 單檔 > 50MB 回 413
6.  test_convert_unsupported_format    — target_format 不在白名單回 415
7.  test_status_nonexistent_job        — 未知 job_id 回 404
8.  test_download_nonexistent_job      — 未知 job_id 回 404
9.  test_convert_valid_request_queues_job — 合法請求回 202 + job_id
10. test_secure_filename_rejects_traversal — 上傳檔名含 ../  被清理
11. test_job_lifecycle                 — 建立 job → 查 status → mock 完成 → 下載
12. test_convert_no_files_empty_list   — 空 files 清單回 400
13. test_formats_matrix_structure      — matrix 欄位含完整 source keys
14. test_health_json_content_type      — /api/health 回 application/json
15. test_convert_unsupported_source_to_target — 不支援的轉換對（pptx→docx）回 415
"""

from __future__ import annotations

import io
import json
import threading
import time
import zipfile
from io import BytesIO
from pathlib import Path
from unittest.mock import MagicMock, patch

import pytest


# ===========================================================================
# 1. GET /api/health
# ===========================================================================


def test_health(client):
    """GET /api/health 應回 200 且 JSON body 含 status: ok。"""
    resp = client.get("/api/health")
    assert resp.status_code == 200
    data = resp.get_json()
    assert data["status"] == "ok"
    assert "converters_ready" in data


# ===========================================================================
# 2. GET /api/formats
# ===========================================================================


def test_formats(client):
    """GET /api/formats 應回 200 且含 formats + matrix 兩個頂層 key。"""
    resp = client.get("/api/formats")
    assert resp.status_code == 200
    data = resp.get_json()
    assert "formats" in data
    assert "matrix" in data
    # formats 應含所有 7 個格式
    for fmt in ("pdf", "docx", "pptx", "html", "md", "txt", "image"):
        assert fmt in data["formats"], f"formats 缺少 {fmt}"
    # 每個格式應有 label, ext, mime
    for fmt, info in data["formats"].items():
        assert "label" in info, f"{fmt} 缺少 label"
        assert "ext" in info, f"{fmt} 缺少 ext"
        assert "mime" in info, f"{fmt} 缺少 mime"


# ===========================================================================
# 3. POST /api/convert — 無檔案
# ===========================================================================


def test_convert_missing_file(client):
    """POST /api/convert 未提供 files 欄位應回 400。"""
    resp = client.post(
        "/api/convert",
        data={"target_format": "docx"},
        content_type="multipart/form-data",
    )
    assert resp.status_code == 400
    data = resp.get_json()
    assert "error" in data


# ===========================================================================
# 4. POST /api/convert — 無 target_format
# ===========================================================================


def test_convert_missing_target_format(client, fake_pdf):
    """POST /api/convert 未提供 target_format 應回 400。"""
    resp = client.post(
        "/api/convert",
        data={"files": (fake_pdf, "test.pdf")},
        content_type="multipart/form-data",
    )
    assert resp.status_code == 400
    data = resp.get_json()
    assert "error" in data


# ===========================================================================
# 5. POST /api/convert — 單檔 > 50MB 回 413
# ===========================================================================


def test_convert_oversized_single_file(client):
    """
    POST /api/convert 上傳超過 50MB 的單一檔案應回 413。
    使用 monkeypatch 模擬大檔（不真正分配 50MB 記憶體）。
    """
    # 建立一個假的大 BytesIO，報告 len=51MB
    large_content = b"X" * (51 * 1024 * 1024)
    resp = client.post(
        "/api/convert",
        data={
            "files": (BytesIO(large_content), "large.pdf"),
            "target_format": "txt",
        },
        content_type="multipart/form-data",
    )
    assert resp.status_code == 413
    data = resp.get_json()
    assert "error" in data


# ===========================================================================
# 6. POST /api/convert — target_format 不在白名單
# ===========================================================================


def test_convert_unsupported_format(client, fake_pdf):
    """POST /api/convert 給不支援的 target_format 應回 415。"""
    resp = client.post(
        "/api/convert",
        data={
            "files": (fake_pdf, "test.pdf"),
            "target_format": "exe",
        },
        content_type="multipart/form-data",
    )
    assert resp.status_code == 415
    data = resp.get_json()
    assert "error" in data


# ===========================================================================
# 7. GET /api/status/<job_id> — 未知 job
# ===========================================================================


def test_status_nonexistent_job(client):
    """GET /api/status/<unknown_job_id> 應回 404。"""
    resp = client.get("/api/status/nonexistent-job-id-0000")
    assert resp.status_code == 404
    data = resp.get_json()
    assert "error" in data


# ===========================================================================
# 8. GET /api/download/<job_id> — 未知 job
# ===========================================================================


def test_download_nonexistent_job(client):
    """GET /api/download/<unknown_job_id> 應回 404。"""
    resp = client.get("/api/download/nonexistent-job-id-9999")
    assert resp.status_code == 404
    data = resp.get_json()
    assert "error" in data


# ===========================================================================
# 9. POST /api/convert — 合法請求回 202 + job_id
# ===========================================================================


def test_convert_valid_request_queues_job(client, fake_pdf):
    """
    合法的 POST /api/convert 應回 202 且 body 含 job_id。
    Mock convert_file 避免實際轉換。
    """
    with patch("app.convert_file") as mock_convert, \
         patch("app._converters_available", True):
        mock_convert.return_value = None

        resp = client.post(
            "/api/convert",
            data={
                "files": (fake_pdf, "test.pdf"),
                "target_format": "txt",
            },
            content_type="multipart/form-data",
        )

    assert resp.status_code == 202
    data = resp.get_json()
    assert "job_id" in data
    assert "file_count" in data
    assert data["file_count"] == 1
    assert "queued_at" in data
    assert "estimated_duration_sec" in data


# ===========================================================================
# 10. secure_filename 路徑穿越防護
# ===========================================================================


def test_secure_filename_rejects_traversal(client):
    """
    上傳含路徑穿越的檔名（../../etc/passwd.pdf）時，
    secure_filename() 應清理檔名，不應返回 400 以外的安全漏洞。
    """
    import app as app_module

    # 驗證 _safe_filename 本身會清理危險字元
    result = app_module._safe_filename("../../etc/passwd.pdf", 0)
    # 清理後不應包含路徑分隔符
    assert ".." not in result
    assert "/" not in result
    assert "\\" not in result
    # 應有索引前綴
    assert result.startswith("0_")


# ===========================================================================
# 11. Job 生命週期整合測試
# ===========================================================================


def test_job_lifecycle(client, fake_txt):
    """
    完整生命週期：
    建立 job → 查 status（queued/processing）→ mock 轉換完成 → 查 status(completed) → 下載
    """
    import app as app_module
    from config import OUTPUT_DIR

    # Step 1: 建立 job（mock convert_file）
    with patch("app.convert_file") as mock_convert, \
         patch("app._converters_available", True):

        def fake_convert(input_path, output_path, source_fmt, target_fmt):
            # 模擬轉換：建立輸出檔案
            out = Path(output_path)
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text("converted content", encoding="utf-8")

        mock_convert.side_effect = fake_convert

        resp = client.post(
            "/api/convert",
            data={
                "files": (fake_txt, "hello.txt"),
                "target_format": "html",
            },
            content_type="multipart/form-data",
        )

    assert resp.status_code == 202
    job_id = resp.get_json()["job_id"]

    # Step 2: 等待轉換完成（最多 5 秒）
    deadline = time.time() + 5
    final_status = None
    while time.time() < deadline:
        status_resp = client.get(f"/api/status/{job_id}")
        assert status_resp.status_code == 200
        status_data = status_resp.get_json()
        final_status = status_data["status"]
        if final_status in ("completed", "partial", "failed"):
            break
        time.sleep(0.1)

    # Step 3: 驗證 status 結構
    status_resp = client.get(f"/api/status/{job_id}")
    assert status_resp.status_code == 200
    data = status_resp.get_json()
    assert "job_id" in data
    assert "status" in data
    assert "progress" in data
    assert "files" in data
    assert isinstance(data["files"], list)

    # Step 4: 若完成，嘗試下載
    if final_status in ("completed", "partial"):
        dl_resp = client.get(f"/api/download/{job_id}")
        # 應可下載（200）
        assert dl_resp.status_code == 200


# ===========================================================================
# 12. 空 files 清單
# ===========================================================================


def test_convert_no_files_empty_list(client):
    """POST /api/convert files 欄位為空字串，應回 400。"""
    resp = client.post(
        "/api/convert",
        data={
            "files": (BytesIO(b""), ""),
            "target_format": "txt",
        },
        content_type="multipart/form-data",
    )
    # 空檔名 → 應被拒絕，400
    assert resp.status_code in (400, 415)
    data = resp.get_json()
    assert "error" in data


# ===========================================================================
# 13. /api/formats matrix 結構驗證
# ===========================================================================


def test_formats_matrix_structure(client):
    """matrix 應包含所有已知 source format 的 key。"""
    resp = client.get("/api/formats")
    assert resp.status_code == 200
    data = resp.get_json()
    matrix = data["matrix"]
    # 至少這些 source keys 應存在
    expected_sources = {"pdf", "docx", "pptx", "html", "md", "txt", "image"}
    for src in expected_sources:
        assert src in matrix, f"matrix 缺少 source: {src}"
    # 每個 source 的 value 應是 dict
    for src, targets in matrix.items():
        assert isinstance(targets, dict), f"matrix[{src}] 應是 dict"


# ===========================================================================
# 14. /api/health Content-Type
# ===========================================================================


def test_health_json_content_type(client):
    """GET /api/health 應回傳 Content-Type: application/json。"""
    resp = client.get("/api/health")
    assert resp.status_code == 200
    assert "application/json" in resp.content_type


# ===========================================================================
# 15. 不支援的轉換對（pptx → docx）應回 415
# ===========================================================================


def test_convert_unsupported_source_to_target(client, fake_pdf):
    """
    PPTX → DOCX 不在 CONVERSION_MATRIX 中（v1.0 不支援），
    POST /api/convert 應回 415。

    使用一個 .pptx 副檔名的假檔案來觸發矩陣檢查。
    """
    # 建立偽 PPTX bytes（ZIP 格式）
    buf = BytesIO()
    with zipfile.ZipFile(buf, "w") as zf:
        zf.writestr("[Content_Types].xml", "<?xml?>")
    buf.seek(0)

    resp = client.post(
        "/api/convert",
        data={
            "files": (buf, "slide.pptx"),
            "target_format": "docx",
        },
        content_type="multipart/form-data",
    )
    assert resp.status_code == 415
    data = resp.get_json()
    assert "error" in data
